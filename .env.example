# ==============================================================================
# SALÓN DE ESTUDIO - BACKEND REALTIME (VARIABLES DE ENTORNO)
# ==============================================================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Orígenes permitidos (HTTP y Socket.IO), separados por coma. El comodín total '*' NO se acepta.
# Se admite '*' dentro de un segmento del host (previews de Vercel):
#   https://frontend-*-miniproyecto-2pi.vercel.app
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# ==============================================================================
# FIREBASE ADMIN SDK (verificación del ID token en el handshake de Socket.IO)
# Use el MISMO proyecto de Firebase que el Backend API. Escoja UNA opción.
# NUNCA suba el archivo '.env' con valores reales al repositorio.
# ==============================================================================

# OPCIÓN 1 (Recomendada para Render): JSON completo de la cuenta de servicio en una sola línea
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# OPCIÓN 2: variables individuales
FIREBASE_PROJECT_ID=tu-proyecto-firebase-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-firebase-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# OPCIÓN 3: ruta a un archivo JSON local (ignorado por .gitignore)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# OPCIÓN 4: emulador local de Firebase Auth (no requiere credenciales)
# FIREBASE_PROJECT_ID=demo-estudiemos
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Configuración STUN / TURN para WebRTC (Sprint 4 - TS-03)
# STUN_SERVER_URL=stun:stun.l.google.com:19302

