{
  "name": "backend-realtime",
  "version": "1.0.0",
  "description": "Servidor de Tiempo Real (WebSockets y WebRTC Signaling) para Salón de Estudio Colaborativo - MiniProyecto 2",
  "main": "dist/server.js",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "socket.io",
    "webrtc",
    "websockets",
    "realtime",
    "docker",
    "render"
  ],
  "author": "Equipo MiniProyecto 2",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
